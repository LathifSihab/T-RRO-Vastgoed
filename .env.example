# WHISE-gegevens voor de website (van WHISE of het makelaarskantoor).
# Online: vul deze in bij Netlify → Site configuration → Environment variables.
# Lokaal testen: kopieer dit bestand naar .env (dat staat in .gitignore).
WHISE_USERNAME=
WHISE_PASSWORD=
WHISE_CLIENT_ID=
WHISE_OFFICE_ID=

# Optioneel
# WHISE_BASE_URL=https://api.whise.eu/
# WHISE_LANGUAGE=nl-BE
